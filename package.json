{
  "name": "sub-tool",
  "version": "6.0.0",
  "description": "SUB Tool 上字幕工具",
  "author": "Evan",
  "repository": "evanwayc-star/SUB_Tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "electron:dev": "electron . --dev",
    "predist": "node scripts/verify-native-binaries.js --platform win32 --arch x64",
    "dist": "vite build && electron-builder --win --x64",
    "native:prepare:mac": "node scripts/prepare-macos-native-binaries.js",
    "dist:mac:test": "npm run native:prepare:mac && node scripts/verify-native-binaries.js --platform darwin --arch arm64 && npm run build && electron-builder --mac --arm64 -c.mac.identity=null -c.mac.hardenedRuntime=false",
    "release:verify-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-install.ps1",
    "lint": "eslint src electron",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.subtool.app",
    "productName": "SUB Tool",
    "icon": "electron/logo.png",
    "fileAssociations": [
      {
        "ext": "subtool",
        "name": "SUB Tool Project",
        "description": "SUB Tool Project File",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "font",
        "to": "font",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "electron/mpv/**",
      "electron/ffmpeg/**",
      "electron/export-watchdog.js",
      "electron/export-lease.js"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "dist/**/*",
        {
          "from": "electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!ffmpeg/**",
            "!mpv/**"
          ]
        },
        {
          "from": "electron/ffmpeg",
          "to": "electron/ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        },
        {
          "from": "electron/mpv",
          "to": "electron/mpv",
          "filter": [
            "mpv.exe",
            "d3dcompiler_43.dll"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "SUB Tool-${version}-mac-${arch}.${ext}",
      "files": [
        "dist/**/*",
        {
          "from": "electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!ffmpeg/**",
            "!mpv/**"
          ]
        },
        {
          "from": "electron/ffmpeg/darwin-arm64",
          "to": "electron/ffmpeg/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SUB Tool"
    }
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^10.5.0",
    "ffmpeg-static": "5.3.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "mp4box": "^2.4.1"
  }
}
