{
  "name": "sub-tool",
  "version": "9.7.0",
  "description": "SUB Tool 上字幕工具",
  "author": "Evan",
  "repository": "evanwayc-star/SUB_Tool",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "vite build && electron .",
    "electron:dev": "electron . --dev",
    "preelectron": "node scripts/release/prepare-frame-ocr.js --if-missing",
    "preelectron:dev": "node scripts/release/prepare-frame-ocr.js --if-missing",
    "native:prepare:frame-ocr": "node scripts/release/prepare-frame-ocr.js",
    "predist": "npm run release:verify-source && node scripts/release/verify-native-binaries.js --platform win32 --arch x64 && npm run native:prepare:card-vision",
    "dist": "vite build && electron-builder --win --x64",
    "native:prepare:mac": "node scripts/release/prepare-macos-native-binaries.js",
    "native:prepare:disc": "node scripts/release/prepare-windows-disc-tools.js",
    "native:prepare:card-vision": "node scripts/release/build-card-vision.js",
    "test:card-vision": "cargo test --manifest-path electron/card-vision/Cargo.toml --locked",
    "dist:mac:test": "npm run native:prepare:mac && node scripts/release/verify-native-binaries.js --platform darwin --arch arm64 && npm run native:prepare:card-vision && npm run build && electron-builder --mac --arm64 -c.mac.identity=null -c.mac.hardenedRuntime=false",
    "release:prepare": "node scripts/release/release-transaction.js prepare",
    "release:verify-source": "node scripts/release/release-transaction.js verify",
    "release:verify-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify-release-install.ps1",
    "lint": "eslint src electron shared scripts",
    "pretest": "node node_modules/electron/install.js",
    "test": "vitest run",
    "test:ci:portable": "node scripts/ci/run-test-group.mjs portable",
    "test:ci:windows": "node scripts/ci/run-test-group.mjs windows",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.subtool.app",
    "productName": "SUB Tool",
    "icon": "electron/logo.png",
    "fileAssociations": [
      {
        "ext": "subtool",
        "name": "SUB Tool Project",
        "description": "SUB Tool Project File",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron/frame-ocr/THIRD_PARTY_NOTICES.txt",
        "to": "frame-ocr/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/tesseract.js-core",
        "to": "frame-ocr/tesseract.js-core",
        "filter": [
          "tesseract-core-simd.js",
          "tesseract-core-simd.wasm",
          "LICENSE"
        ]
      },
      {
        "from": "node_modules/@tesseract.js-data",
        "to": "frame-ocr/@tesseract.js-data",
        "filter": [
          "*/4.0.0_best_int/*.traineddata.gz",
          "*/package.json"
        ]
      },
      {
        "from": "electron/frame-ocr/paddle",
        "to": "frame-ocr/paddle",
        "filter": [
          "*.onnx",
          "*characters.json"
        ]
      },
      {
        "from": "electron/frame-ocr/scripts",
        "to": "frame-ocr/scripts",
        "filter": [
          "*.traineddata.gz",
          "LICENSE.txt"
        ]
      },
      {
        "from": "electron/card-vision/bin/${platform}-${arch}",
        "to": "card-vision",
        "filter": [
          "subtool-card-vision",
          "subtool-card-vision.exe",
          "THIRD_PARTY_NOTICES.txt",
          "RUST_STANDARD_LIBRARY_NOTICES.html"
        ]
      },
      {
        "from": "font",
        "to": "font",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "./scripts/release/prepare-frame-ocr.js",
    "asarUnpack": [
      "electron/frame-text-worker.js",
      "electron/frame-text-paddle.js",
      "node_modules/pngjs/**",
      "node_modules/onnxruntime-common/package.json",
      "node_modules/onnxruntime-common/dist/cjs/**",
      "node_modules/onnxruntime-web/package.json",
      "node_modules/onnxruntime-web/dist/ort.node.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
      "electron/mpv/**",
      "electron/ffmpeg/**",
      "electron/export-watchdog.js",
      "electron/delivery-temporary-input.js",
      "electron/export-artifact.js",
      "electron/delivery-verification.js",
      "electron/delivery-reverse.js",
      "electron/owned-output-handle.js",
      "electron/mod-fhd-transport.js",
      "electron/airline-output.js",
      "electron/airline-transport.js",
      "electron/airline-encoding.js",
      "electron/disc-authoring.js",
      "electron/disc-encoding.js",
      "electron/disc/**",
      "shared/delivery-formats.cjs",
      "shared/delivery-frame-rate.cjs",
      "electron/export-lease.js"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "dist/**/*",
        "shared/**/*.cjs",
        "!node_modules/onnxruntime-web/dist/*.map",
        "!node_modules/onnxruntime-web/dist/ort.{all,jspi,wasm,webgl,webgpu}.*",
        "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{asyncify,jsep,jspi}.{mjs,wasm}",
        {
          "from": "electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!ffmpeg/**",
            "!screen-text-worker.py",
            "!ocr-requirements.txt",
            "!card-vision/**",
            "!frame-ocr/scripts/**",
            "!frame-ocr/paddle/**",
            "!mpv/**",
            "!disc/**"
          ]
        },
        {
          "from": "electron/ffmpeg",
          "to": "electron/ffmpeg",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        },
        {
          "from": "electron/mpv",
          "to": "electron/mpv",
          "filter": [
            "mpv.exe",
            "d3dcompiler_43.dll"
          ]
        },
        {
          "from": "electron/disc",
          "to": "electron/disc",
          "filter": [
            "dvdauthor.exe",
            "mkisofs.exe",
            "cygwin1.dll",
            "libiconv-2.dll",
            "libxml2-2.dll",
            "liblzma-5.dll",
            "zlib1.dll",
            "tsMuxeR.exe",
            "dvdauthor.LICENSE",
            "mkisofs.LICENSE",
            "mkisofs-GPL.LICENSE",
            "mkisofs-CDDL.LICENSE",
            "tsMuxeR.LICENSE",
            "cygwin.LICENSE",
            "cygwin-exception.LICENSE",
            "libiconv.LICENSE",
            "libxml2.LICENSE",
            "liblzma.LICENSE",
            "zlib.LICENSE"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "SUB Tool-${version}-mac-${arch}.${ext}",
      "files": [
        "dist/**/*",
        "shared/**/*.cjs",
        "!node_modules/onnxruntime-web/dist/*.map",
        "!node_modules/onnxruntime-web/dist/ort.{all,jspi,wasm,webgl,webgpu}.*",
        "!node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{asyncify,jsep,jspi}.{mjs,wasm}",
        {
          "from": "electron",
          "to": "electron",
          "filter": [
            "**/*",
            "!ffmpeg/**",
            "!screen-text-worker.py",
            "!ocr-requirements.txt",
            "!card-vision/**",
            "!frame-ocr/scripts/**",
            "!frame-ocr/paddle/**",
            "!mpv/**",
            "!disc/**"
          ]
        },
        {
          "from": "electron/ffmpeg/darwin-arm64",
          "to": "electron/ffmpeg/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SUB Tool"
    }
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/ell": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/heb": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tesseract.js-data/osd": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "7zip-bin": "5.2.0",
    "acorn": "^8.18.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "ffmpeg-static": "5.3.0",
    "globals": "^17.6.0",
    "js-yaml": "4.3.2",
    "jsdom": "^29.1.1",
    "tesseract.js-core": "7.0.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "mp4box": "^2.4.1",
    "onnxruntime-web": "1.30.0",
    "opencc-js": "1.4.2",
    "pngjs": "7.0.0",
    "web-audio-separation": "0.3.1"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "brace-expansion@^5.0.0": "^5.0.12"
  }
}
